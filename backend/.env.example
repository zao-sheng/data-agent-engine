# data-agent-engine 运行配置（复制为 .env 后按需修改；所有项均可省略）
# 所有键使用 DATA_AGENT_ 前缀，与 DSH / 宿主环境隔离。

# ── 本体存储（1A/1B/2）─────────────────────────────────────────
# 存储类型：yaml（默认，发布基线快照）/ sqlite（编译产物缓存，需先 ontology_compile）
#          / supabase（多人编辑真源，需下面三个配置）
# DATA_AGENT_ONTOLOGY_STORE=yaml
# DATA_AGENT_ONTOLOGY=backend/ontology
# DATA_AGENT_ONTOLOGY_DB=backend/ontology.db
# Supabase（阶段2）：本体真源；建表脚本见 backend/supabase/schema.sql
# DATA_AGENT_SUPABASE_URL=https://xxxx.supabase.co
# DATA_AGENT_SUPABASE_KEY=service_role_key
# DATA_AGENT_SUPABASE_SCHEMA=public

# ── 数据介质 ────────────────────────────────────────────────
# SQLite 样例库（默认 backend/seed/sample.db）
# DATA_AGENT_DB=backend/seed/sample.db
# Ontology 目录（默认 backend/ontology）
# DATA_AGENT_ONTOLOGY=backend/ontology

# ── 默认方言（sqlite | mysql | doris | hive | sparksql）─────
# DATA_AGENT_DIALECT=sqlite

# ── 远程数仓连接串（P1-5）──────────────────────────────────
# 格式：scheme://user:pass@host:port/db
# MySQL / Doris（Doris 兼容 MySQL 协议，驱动 pymysql）：
# DATA_AGENT_DSN_MYSQL=mysql://readonly:secret@dw.internal:3306/order_dw
# DATA_AGENT_DSN_DORIS=doris://readonly:secret@doris.internal:9030/order_dw
# Hive / SparkSQL（Thrift，驱动 pyhive thrift sasl）：
# DATA_AGENT_DSN_HIVE=hive://reader@hive.internal:10000/order_dw
# DATA_AGENT_DSN_SPARKSQL=sparksql://reader@spark-thrift.internal:10000/order_dw
# 远程连接超时（秒）
# DATA_AGENT_REMOTE_TIMEOUT=15

# ── 安全（P0 / P4）───────────────────────────────────────
# 查询令牌有效期（秒，默认 300）
# DATA_AGENT_TOKEN_TTL=300
# 令牌池容量上限（默认 500，超出淘汰最旧）
# DATA_AGENT_TOKEN_MAX=500
# 确认令牌有效期（秒，默认 600）与容量上限（默认 200）
# DATA_AGENT_CONFIRM_TOKEN_TTL=600
# DATA_AGENT_CONFIRM_TOKEN_MAX=200

# ── 日志（P0 审计 / P2 请求日志）───────────────────────────
# 日志目录（默认 backend/logs）
# DATA_AGENT_LOG_DIR=backend/logs
# 日志级别（DEBUG/INFO/WARNING/ERROR，默认 INFO）
# DATA_AGENT_LOG_LEVEL=INFO
# 审计日志单文件上限（字节，默认 10MB）与保留份数（默认 7）
# DATA_AGENT_AUDIT_MAX_BYTES=10485760
# DATA_AGENT_AUDIT_BACKUPS=7
